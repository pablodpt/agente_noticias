# Token que te da @BotFather en Telegram
TELEGRAM_TOKEN=123456789:AA...
# Tu chat id (habla con @userinfobot para obtenerlo)
TELEGRAM_CHAT_ID=123456789

# --- Opcionales ---
TZ_USUARIO=Europe/Madrid
HORA_BOLETIN=18
UMBRAL_MOVIMIENTO_PCT=3.0
UMBRAL_GAP_PCT=3.0
UMBRAL_VOLUMEN_X=2.5
INTERVALO_VIGILANCIA_SEG=900
USAR_FINBERT=false
SEC_USER_AGENT=agente-noticias tu-email@dominio.com

# --- Base de datos local y correlaciones ---
# ARCHIVO_DATOS=datos/portafolio.db
# Años de histórico que rellena `python agente.py datos --bootstrap`
AÑOS_BOOTSTRAP=5
# Horas mínimas entre persistencias automáticas (0 = siempre)
PERSISTIR_CADA_HORAS=4
# Por encima de esta correlación se alerta de "concentración"
UMBRAL_CORR_ALTA=0.70
# Por debajo, se señala "apuesta independiente"
UMBRAL_CORR_BAJA=-0.20

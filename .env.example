# Token que te da @BotFather en Telegram
TELEGRAM_TOKEN=123456789:AA...
# Tu chat id (habla con @userinfobot para obtenerlo)
TELEGRAM_CHAT_ID=123456789

# --- Opcionales (boletín de cartera) ---
TZ_USUARIO=Europe/Madrid
HORA_BOLETIN=18
UMBRAL_MOVIMIENTO_PCT=3.0
UMBRAL_GAP_PCT=3.0
UMBRAL_VOLUMEN_X=2.5
INTERVALO_VIGILANCIA_SEG=900
USAR_FINBERT=false
SEC_USER_AGENT=agente-noticias tu-email@dominio.com

# ============================================================================
#  Detector de oportunidades (oportunidades.py)
# ============================================================================

# sp500 | personalizado | mezcla (S&P 500 + tu lista + tu cartera) | portafolio
UNIVERSO=sp500
# Lista propia (archivo de texto, un ticker por línea)
ARCHIVO_UNIVERSO=datos/mi_universo.txt
# ...o en línea, separada por comas: UNIVERSO_TICKERS=AAPL,SAN.MC,BTC-USD
# Refrescar la lista del S&P 500 desde Wikipedia si tiene más de X días
UNIVERSO_REFRESCAR_DIAS=30
UNIVERSO_AUTOACTUALIZAR=true
# 0 = sin límite (útil para pruebas rápidas: MAX_TICKERS_UNIVERSO=40)
MAX_TICKERS_UNIVERSO=0

# Cuántas ideas muestra cada informe
TOP_DIARIO=8
TOP_SEMANAL=15
# Máximo de ideas del mismo sector en la lista final (diversificación)
MAX_POR_SECTOR=3
# Puntuación mínima (0-100) para que una idea entre en el informe
UMBRAL_FINAL=50

# Pesos de cada motor (no hace falta que sumen 1, se normalizan solos)
# PESOS_ESTRATEGIA=momentum:0.30,reversion:0.25,valor:0.25,catalizador:0.20

# Filtros: descarta chicharros, ilíquidos y valores sin historial suficiente
PRECIO_MINIMO=5
VOLUMEN_DOLARES_MIN=20000000
SESIONES_MINIMAS=200

# Coste del escaneo
FUND_TOP_DIARIO=70
FUND_TODOS_SEMANAL=600
MAX_TICKERS_NOTICIAS=25
HILOS_FUNDAMENTALES=12
CACHE_FUND_HORAS=12
TAMANO_LOTE=60

# Horas que una idea ya avisada no se vuelve a enviar por Telegram
TTL_OPORTUNIDAD_HORAS=96
